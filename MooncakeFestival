 linear-gradient(180deg,#fff0dc,#efad91)}
.decor-layout{align-items:start}
.decor-panel{background:linear-gradient(145deg,#fffaf0,#ffe8d7);border-color:#d99a76}
.decor-btn{position:relative;min-height:74px;transition:.18s;overflow:hidden}.decor-btn em{display:block;font-size:8px;font-style:normal;color:#a67b77;letter-spacing:1px}.decor-btn.locked{filter:grayscale(1);opacity:.45;cursor:not-allowed}.decor-btn:not(.locked):hover{transform:translateY(-3px);box-shadow:0 7px 0 rgba(130,66,55,.12)}
.decor-unlock{margin:10px 0;padding:9px;border-radius:12px;background:#ffe2b9;border:1px solid #e1b15f;text-align:center;font-weight:900;font-size:12px}
.cake-table{height:600px;background:
 radial-gradient(circle at 50% 40%,rgba(255,237,181,.4) 0 3px,transparent 4px),
 linear-gradient(145deg,#d98267,#f3c49c 50%,#d8876d);border-color:#d49a65}
