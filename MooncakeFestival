.cake-plate{width:430px;height:125px;background:radial-gradient(ellipse,#fffaf0 0 65%,#e5c28f 66% 72%,#fff3d8 73%);box-shadow:0 16px 0 #bd805f,0 25px 30px rgba(75,35,38,.2)}
.cake{width:275px;height:155px;box-shadow:inset 0 -12px rgba(116,68,51,.18),0 13px 18px rgba(82,40,38,.2)}
