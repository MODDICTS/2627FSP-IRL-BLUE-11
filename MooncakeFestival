/* ---------------- CLAW MACHINE PHYSICS ---------------- */
let clawX=50,clawBusy=false;
const prizeTypes=["🌸","🍓","⭐","🌙","🦋","🍡"];
let inventory=[];

function spawnBalls(){
  machineScreen.querySelectorAll(".prize-ball").forEach(x=>x.remove());
  prizeTypes.forEach((p,i)=>{
    const b=document.createElement("div");b.className="prize-ball bounce";b.textContent=p;b.dataset.prize=p;
    b.style.left=(7+Math.random()*82)+"%";b.style.bottom=(7+Math.random()*17)+"%";
    b.style.animationDelay=(Math.random()*1.5)+"s";
    machineScreen.appendChild(b);
  });
}
function moveClaw(dir){
  if(clawBusy)return;
  clawX=Math.max(7,Math.min(93,clawX+dir*7));
  clawRig.style.left=clawX+"%";
}
function dropClaw(){
  if(clawBusy)return;
  if(coins<2){toast("🪙 Butuh 2 coins! Jawab quiz dulu.");go("quiz");return}
  coins-=2;updateCoins();clawBusy=true;clawRig.classList.add("grabbing");
  clawRig.style.transition="top .75s ease";clawRig.style.top="325px";
  setTimeout(()=>{
    const balls=[...machineScreen.querySelectorAll(".prize-ball")];
    let nearest=null,best=999;
    balls.forEach(ball=>{
      const x=parseFloat(ball.style.left);const d=Math.abs(x-clawX);
      if(d<best){best=d;nearest=ball}
    });
    if(nearest && best<13){
      const prize=nearest.dataset.prize;
      nearest.style.transition="all .65s";nearest.style.left=clawX+"%";nearest.style.bottom="42%";nearest.classList.remove("bounce");
      setTimeout(()=>{
        nearest.style.transform="translateY(-150px)";nearest.style.opacity="0";
        inventory.push(prize);renderInventory();toast("抓到了 "+prize+"! 🎉");
      },250);
    }else toast("抓空了～ Coba bidik lebih dekat!");
    setTimeout(()=>{
      clawRig.style.top="0";clawRig.classList.remove("grabbing");
      setTimeout(()=>{clawBusy=false;spawnBalls()},800);
    },1100);
  },800);
}
function renderInventory(){inventoryEl.textContent=inventory.join(" ");refreshDecorUnlocks()}
document.addEventListener("keydown",e=>{
  if(!document.getElementById("claw").classList.contains("active-room"))return;
  if(["INPUT","SELECT","TEXTAREA"].includes(document.activeElement.tagName))return;
  if(e.key==="ArrowLeft"||e.key==="a"||e.key==="A"){e.preventDefault();moveClaw(-1)}
  if(e.key==="ArrowRight"||e.key==="d"||e.key==="D"){e.preventDefault();moveClaw(1)}
  if(e.key==="ArrowDown"||e.key==="s"||e.key==="S"||e.key==="Enter"){e.preventDefault();dropClaw()}
});

/* ---------------- DECOR ---------------- */
const decorButtons=[...document.querySelectorAll(".decor-btn")];
function refreshDecorUnlocks(){
  const owned=new Set(inventory);
  let count=0;
  decorButtons.forEach(btn=>{
    const key=btn.dataset.decor, unlocked=owned.has(key);
    btn.disabled=!unlocked;
    btn.classList.toggle("locked",!unlocked);
    btn.querySelector("em").textContent=unlocked?"UNLOCKED":"LOCKED";
    if(unlocked)count++;
  });
  const unlock=document.getElementById("decorUnlock");
  if(unlock)unlock.textContent=`${count} / ${prizeTypes.length} unlocked`;
}
function addDecor(symbol){
  if(!inventory.includes(symbol)){toast("🔒 Hadiah ini belum didapat dari Claw Machine!");return}
  const item=document.createElement("div");item.className="decor-item";item.textContent=symbol;
  item.style.left=(38+Math.random()*25)+"%";item.style.top=(35+Math.random()*25)+"%";
  item.addEventListener("dblclick",()=>item.remove());
  item.addEventListener("pointerdown",e=>{
    e.preventDefault();item.setPointerCapture(e.pointerId);item.classList.add("selected");
    const rect=cakeTable.getBoundingClientRect(), ir=item.getBoundingClientRect();
    const ox=e.clientX-ir.left,oy=e.clientY-ir.top;
    const move=ev=>{
      const x=Math.max(8,Math.min(rect.width-8,ev.clientX-rect.left-ox));
      const y=Math.max(8,Math.min(rect.height-8,ev.clientY-rect.top-oy));
      item.style.left=x+"px";item.style.top=y+"px";item.style.transform="translate(-50%,-50%)";
    };
    const up=ev=>{item.releasePointerCapture(ev.pointerId);item.classList.remove("selected");item.removeEventListener("pointermove",move);item.removeEventListener("pointerup",up)};
    item.addEventListener("pointermove",move);item.addEventListener("pointerup",up);
  });
  cakeTable.appendChild(item);
}
function clearDecor(){document.querySelectorAll(".decor-item").forEach(x=>x.remove())}
function serveMooncake(){
