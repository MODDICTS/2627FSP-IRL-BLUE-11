.machine:after{content:"✦  🏮  ✦  🥮  ✦  🏮  ✦";display:block;text-align:center;color:#ffd76a;font-size:18px;position:absolute;top:8px;left:0;right:0}
.machine-screen{height:520px;background:
 radial-gradient(circle at 14% 12%,#ffe58d 0 2px,transparent 3px),
