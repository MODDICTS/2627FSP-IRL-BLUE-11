   ========================================================= */

function go(id){
  const room=document.getElementById(id);
  if(!room || !room.classList.contains("room")) return;
  document.querySelectorAll(".room").forEach(r=>r.classList.remove("active-room"));
  room.classList.add("active-room");
  document.body.classList.toggle("home-view", id==="home");
  document.querySelectorAll(".topbar button[data-room]").forEach(b=>b.classList.toggle("active",b.dataset.room===id));
  window.scrollTo({top:0,behavior:"auto"});
}

/* ---------------- QUOTES ---------------- */
const quotes=[
 {h:"但愿人长久",p:"dàn yuàn rén cháng jiǔ",m:"Semoga orang yang kita sayangi selalu sehat dan bersama.",e:"Ungkapan harapan baik yang cocok dengan tema kebersamaan saat 中秋节."},
 {h:"月圆人团圆",p:"yuè yuán rén tuán yuán",m:"Bulan purnama, orang-orang berkumpul kembali.",e:"Melambangkan keluarga, kebersamaan, dan reuni saat festival."},
 {h:"有志者事竟成",p:"yǒu zhì zhě shì jìng chéng",m:"Orang yang punya tekad akan berhasil.",e:"Pepatah tentang kemauan dan ketekunan untuk mencapai tujuan."},
 {h:"一步一个脚印",p:"yí bù yí ge jiǎo yìn",m:"Melangkah setahap demi setahap.",e:"Kemajuan kecil yang konsisten tetap berarti."},
 {h:"希望",p:"xīwàng",m:"Harapan; berharap.",e:"Dipakai untuk menyatakan sesuatu yang kita harapkan terjadi."},
 {h:"更好",p:"gèng hǎo",m:"Lebih baik.",e:"更 menyatakan tingkat yang lebih tinggi, misalnya 比以前更好."},
 {h:"一起",p:"yìqǐ",m:"Bersama-sama.",e:"Contoh: 我们一起吃月饼。Kita makan mooncake bersama."},
 {h:"祝福",p:"zhùfú",m:"Berkah; doa/harapan baik.",e:"Sering digunakan ketika memberikan ucapan baik kepada orang lain."},
 {h:"家人",p:"jiārén",m:"Keluarga; anggota keluarga.",e:"Kosakata penting karena 中秋节 erat dengan keluarga."}
];
let quoteIndex=0;
function drawQuote(){
  const c=document.getElementById("quoteCard");c.classList.remove("flipped");
  quoteIndex=(quoteIndex+1)%quotes.length;
  const q=quotes[quoteIndex];
  setTimeout(()=>{
    quoteHanzi.textContent=q.h;quotePinyin.textContent=q.p;quoteMeaning.textContent=q.m;quoteExplain.textContent=q.e;
  },220);
}

/* ---------------- COINS ---------------- */
let coins=0;
function updateCoins(){
  globalCoins.textContent=coins;quizCoins.textContent=coins;clawCoins.textContent=coins;
}
function toast(msg){
  const t=document.getElementById("toast");t.textContent=msg;t.classList.add("show");
  clearTimeout(window.tt);window.tt=setTimeout(()=>t.classList.remove("show"),2600);
}

/* ---------------- QUIZ ---------------- */
const quizData=[
 {h:"希望",p:"xīwàng",a:"harapan / berharap",o:["harapan / berharap","lebih baik","bersama-sama","keluarga"]},
 {h:"更",p:"gèng",a:"lebih / semakin",o:["memberi","lebih / semakin","bulan","bahagia"]},
 {h:"比",p:"bǐ",a:"dibandingkan / daripada",o:["dibandingkan / daripada","memberi","keluarga","makan"]},
 {h:"给",p:"gěi",a:"memberi / kepada",o:["bersama","memberi / kepada","harapan","bulan purnama"]},
 {h:"一起",p:"yìqǐ",a:"bersama-sama",o:["bersama-sama","lebih baik","bahagia","keluarga"]},
 {h:"喜欢",p:"xǐhuan",a:"suka / menyukai",o:["membuat","suka / menyukai","memberi","harapan"]},
 {h:"家人",p:"jiārén",a:"keluarga",o:["keluarga","bulan","teman","makanan"]},
 {h:"团圆",p:"tuányuán",a:"berkumpul bersama / reuni",o:["berkumpul bersama / reuni","lebih","berharap","belajar"]}
];
let qi=0,score=0,answered=false;
function renderQuiz(){
  const q=quizData[qi];qNumber.textContent=`Question ${qi+1} / ${quizData.length}`;
  qHanzi.textContent=q.h;qPinyin.textContent=q.p;
  quizProgress.style.width=((qi)/quizData.length*100)+"%";
  quizScore.textContent="Score: "+score;quizMessage.textContent="";nextBtn.disabled=true;answered=false;
  options.innerHTML="";
  [...q.o].sort(()=>Math.random()-.5).forEach(opt=>{
    const b=document.createElement("button");b.className="option";b.textContent=opt;
    b.onclick=()=>answerQuiz(b,opt,q.a);options.appendChild(b);
  });
}
function answerQuiz(btn,choice,correct){
  if(answered)return;answered=true;
  document.querySelectorAll(".option").forEach(b=>b.disabled=true);
  if(choice===correct){
    btn.classList.add("correct");score++;coins+=3;updateCoins();
    quizMessage.textContent="正确！ +3 coins ✨ Jawaban benar!";
    toast("正确！ +3 coins 🪙");
  }else{
    btn.classList.add("wrong");
    quizMessage.textContent="差一点～ Jawaban benar: "+correct;
    document.querySelectorAll(".option").forEach(b=>{if(b.textContent===correct)b.classList.add("correct")});
  }
  quizScore.textContent="Score: "+score;nextBtn.disabled=false;
}
function nextQuiz(){if(!answered)return;qi=(qi+1)%quizData.length;renderQuiz()}

/* ---------------- KITCHEN: ONE BOX, MULTIPLE GAMEPLAY STAGES ---------------- */
const needed=["flour","sugar","oil","egg","lotus"];
let chosen=new Set(),cookStage=1,cookProgress=0,dragItem=null;
document.querySelectorAll(".ingredient").forEach(el=>{
  el.addEventListener("dragstart",e=>{
    if(el.classList.contains("used"))return;
    dragItem=el.dataset.ing;e.dataTransfer.setData("text/plain",dragItem);el.classList.add("dragging");
  });
  el.addEventListener("dragend",()=>el.classList.remove("dragging"));
});
dropTarget.addEventListener("dragover",e=>{e.preventDefault();dropTarget.classList.add("over")});
dropTarget.addEventListener("dragleave",()=>dropTarget.classList.remove("over"));
dropTarget.addEventListener("drop",e=>{
  e.preventDefault();dropTarget.classList.remove("over");
  const ing=e.dataTransfer.getData("text/plain")||dragItem;
  if(ing)addIngredient(ing);
});
document.getElementById("ingredientTarget").addEventListener("dragover",e=>e.preventDefault());
document.getElementById("ingredientTarget").addEventListener("drop",e=>{
  e.preventDefault();const ing=e.dataTransfer.getData("text/plain")||dragItem;if(ing)addIngredient(ing);
});

function addIngredient(ing){
  if(cookStage!==1||chosen.has(ing))return;
  if(ing==="salt"){toast("🧂 Salt is optional — coba bahan utama dulu!");return}
  chosen.add(ing);
  const el=document.querySelector(`.ingredient[data-ing="${ing}"]`);el.classList.add("used");
  cookProgress=chosen.size;
  cookCounter.textContent=`${chosen.size} / 5 ingredients`;
  toast("Masuk ke bowl! "+ing+" ✓");
  if(chosen.size===5)setTimeout(()=>setCookStage(2),450);
}
function setCookStage(stage){
  cookStage=stage;dropTarget.style.display="none";cookVisual.innerHTML="";
  cookActions.innerHTML="";
  const hint=document.getElementById("cookHint"),inst=document.getElementById("cookInstruction");
  cookCounter.textContent="";
  if(stage===2){
    inst.textContent="Aduk mengikuti arah panah. Klik tombol hanya saat indikator berada di zona GOLD!";
    hint.innerHTML="<strong>💡 小提示 · Hint</strong>Tekan <b>搅拌</b> ketika timing tepat. Semakin banyak perfect, adonan semakin bagus.";
    let turns=0,perfect=0;
    const meter=document.createElement("div");
    meter.style="position:absolute;z-index:20;left:50%;top:55%;transform:translate(-50%,-50%);width:300px;height:25px;background:#efd6ca;border-radius:99px;overflow:hidden";
    meter.innerHTML='<span style="display:block;height:100%;width:28%;margin-left:60%;background:#ffd85c;border-radius:99px"></span>';
    cookBox.appendChild(meter);
    const b=document.createElement("button");b.className="btn gold";b.textContent="搅拌 · ADUK";
    b.onclick=()=>{
      turns++;
      const x=Math.random()*100;
      if(x>65){perfect++;toast("Perfect timing! ⭐")}else toast("Aduk! Teruskan.");
      cookVisual.innerHTML+=`<span class="bit" style="left:${45+Math.random()*12}%;top:${38+Math.random()*22}%">✨</span>`;
      if(turns>=7){
        meter.remove();cookVisual.innerHTML="";
        toast(`Adonan siap! ${perfect} perfect timing ✨`);setCookStage(3);
      }
    };
    cookActions.appendChild(b);
  }else if(stage===3){
    inst.textContent="Uleni adonan: klik saat lingkaran kecil berada tepat di dalam lingkaran besar.";
    hint.innerHTML="<strong>💡 揉面 · Knead</strong>Target bergerak. 6 hit tepat untuk membuat dough elastis.";
    cookVisual.innerHTML='<div class="knead-dough">🟤</div>';
    let hits=0;
    const target=document.createElement("button");target.className="btn red";target.textContent="揉面 · KNEAD";
    target.style.position="absolute";target.style.left="50%";target.style.top="61%";
    target.style.transform="translateX(-50%)";
    target.onclick=()=>{
      hits++;target.style.left=(38+Math.random()*24)+"%";
      toast(`Knead ${hits}/6 💪`);
      if(hits>=6)setCookStage(4);
    };
    cookActions.appendChild(target);
  }else if(stage===4){
    inst.textContent="Roll dough bolak-balik. Jaga bar tetap di area hijau!";
    hint.innerHTML="<strong>💡 擀面皮 · Roll</strong>Tekan ROLL berulang. Panjang dough bertambah kalau timing bagus.";
    cookVisual.innerHTML='<div class="rolling-pin" id="pin">🪵</div><div style="position:absolute;z-index:17;left:50%;top:58%;transform:translateX(-50%);width:330px;height:18px;border-radius:99px;background:#e6d0c5"><span id="rollBar" style="display:block;width:15%;height:100%;border-radius:99px;background:#78a65e"></span></div>';
    let rolls=0;
    const b=document.createElement("button");b.className="btn gold";b.textContent="擀 · ROLL";
    b.onclick=()=>{
      rolls++;pin.style.transform=`translate(-50%,-50%) rotate(${rolls%2?8:-8}deg)`;
      rollBar.style.width=Math.min(100,15+rolls*15)+"%";toast(`Roll ${rolls}/6 ↔️`);
      if(rolls>=6)setCookStage(5);
    };
    cookActions.appendChild(b);
  }else if(stage===5){
    inst.textContent="Sekarang bungkus lotus filling: drag 🫘 ke dough, lalu klik seal!";
    hint.innerHTML="<strong>💡 包馅 · Fill</strong>Drag filling ke dough. Setelah masuk, tekan SEAL untuk mengunci isian.";
    cookVisual.innerHTML='<div class="dough" id="fillDough"><span>🥮</span></div>';
    const fill=document.createElement("div");fill.textContent="🫘";fill.draggable=true;fill.style="position:absolute;z-index:25;left:25%;top:56%;font-size:52px;cursor:grab";
    fill.addEventListener("dragstart",e=>e.dataTransfer.setData("fill","yes"));
    cookBox.appendChild(fill);
    const d=document.getElementById("fillDough");d.addEventListener("dragover",e=>e.preventDefault());
    d.addEventListener("drop",e=>{
      e.preventDefault();if(e.dataTransfer.getData("fill")){fill.remove();d.innerHTML="<span>🥮🫘</span>";d.dataset.filled="yes";toast("Filling masuk! Sekarang seal.");}
    });
    const b=document.createElement("button");b.className="btn red";b.textContent="封口 · SEAL";
    b.onclick=()=>{if(d.dataset.filled==="yes")setCookStage(6);else toast("Masukkan filling dulu! 🫘")};
    cookActions.appendChild(b);
  }else if(stage===6){
    inst.textContent="Tekan mold berulang kali mengikuti ritme: TAP → TAP → HOLD!";
    hint.innerHTML="<strong>💡 压模 · Press</strong>Ikuti pola 3 kali. Setelah 2 TAP, tahan tombol untuk HOLD.";
    cookVisual.innerHTML='<div class="mold">🥮</div>';
    let taps=0;
    const b=document.createElement("button");b.className="btn gold";b.textContent="TAP";
    b.onclick=()=>{
      taps++;
      if(taps<3)toast(taps===2?"Sekarang HOLD!":"TAP lagi!");
      else{toast("Motif mooncake tercetak jelas! ✨");setCookStage(7)}
      if(taps===2){
        b.textContent="HOLD";
        let holdTimer=null;
        const startHold=()=>{
          if(holdTimer!==null)return;
          holdTimer=setTimeout(()=>{taps=3;holdTimer=null;setCookStage(7)},450);
        };
        const cancelHold=()=>{if(holdTimer!==null){clearTimeout(holdTimer);holdTimer=null;}};
        b.addEventListener("pointerdown",startHold);
        b.addEventListener("pointerup",cancelHold);
        b.addEventListener("pointerleave",cancelHold);
      }
    };
    cookActions.appendChild(b);
  }else if(stage===7){
    inst.textContent="Bake dengan timing. Klik BAKE 4 kali; jangan terlalu cepat!";
    hint.innerHTML="<strong>💡 烘烤 · Bake</strong>Setiap klik memanaskan oven. Tunggu sedikit di antara klik agar tidak overheat.";
    cookVisual.innerHTML='<div class="oven"></div><div class="oven-light" id="ovenLight">🔥</div>';
    let heat=0,last=0;
    const b=document.createElement("button");b.className="btn red";b.textContent="烘烤 · BAKE";
    b.onclick=()=>{
      const now=Date.now();
      if(now-last<450){toast("Too fast! Oven hampir overheat 😵‍💫");return}
      last=now;heat++;document.getElementById("ovenLight").style.opacity=Math.min(1,heat/4);toast(`Oven heat ${heat}/4 🔥`);
      if(heat>=4)setTimeout(()=>finishCooking(),500);
    };
    cookActions.appendChild(b);
  }
}
function finishCooking(){
  cookStage=8;cookActions.innerHTML="";
  cookVisual.innerHTML='<div class="cook-finish"><div class="finish-content">🥮<h3>完成！</h3><p>你的月饼做好了！<br>Mooncake-mu selesai!</p><button class="btn gold" onclick="go(\'claw\')">去抓娃娃 · Claw Machine</button></div></div>';
  cookHint.innerHTML="<strong>🎉 完成 · Finished</strong>Mooncake selesai. Sekarang kumpulkan dekorasi!";
  cookInstruction.textContent="Mooncake berhasil dibuat!";
  toast("月饼做好了！ 🥮✨");
}
function resetKitchen(){
  chosen.clear();cookStage=1;
