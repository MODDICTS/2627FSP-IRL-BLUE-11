.claw-hand i:nth-child(1){left:5px;transform:rotate(24deg)}.claw-hand i:nth-child(2){left:28px}.claw-hand i:nth-child(3){right:5px;transform:rotate(-24deg)}
.claw.grabbing .claw-hand i:nth-child(1){transform:rotate(7deg)}.claw.grabbing .claw-hand i:nth-child(3){transform:rotate(-7deg)}
.prize-ball{box-shadow:0 0 0 3px rgba(255,225,185,.18),0 9px 16px rgba(25,14,34,.45)}
.claw-controls{gap:10px;flex-wrap:wrap}.key{position:relative}.key small{display:block;font-size:7px;margin-top:-2px}
.arcade-panel{border:3px solid #e8b55e;background:linear-gradient(#fff8e8,#ffe8d2)}
.inventory{min-height:54px;padding:9px;border:2px dashed #ddb26a;border-radius:14px;background:#fff9ed}
