.claw-head span{position:absolute;width:7px;height:7px;background:#fff3c5;border-radius:50%;top:4px}.claw-head span:nth-child(1){left:12px}.claw-head span:nth-child(2){left:28px}.claw-head span:nth-child(3){right:10px}
