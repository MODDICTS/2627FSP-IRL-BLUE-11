.decor-item.selected{outline:2px dashed #e7b446;outline-offset:5px}
.serve-scene{position:fixed;inset:0;z-index:500;display:none;overflow:hidden;background:#171933}
.serve-scene.show{display:block}
.serve-sky{position:absolute;inset:0;background:
 radial-gradient(circle at 15% 16%,#fff0a6 0 2px,transparent 3px),
 radial-gradient(circle at 30% 25%,#ffe890 0 2px,transparent 3px),
 radial-gradient(circle at 74% 14%,#fff0a6 0 3px,transparent 4px),
 radial-gradient(circle at 88% 35%,#ffe890 0 2px,transparent 3px),
 linear-gradient(180deg,#171b40,#3e2c55 62%,#9b574f)}
.serve-moon{position:absolute;right:11%;top:9%;width:150px;height:150px;border-radius:50%;background:#ffe99a;box-shadow:0 0 80px rgba(255,226,129,.55)}
.serve-lantern{position:absolute;font-size:52px;animation:sway 3s ease-in-out infinite}.serve-lantern.l1{left:8%;top:11%}.serve-lantern.l2{left:47%;top:5%;animation-delay:.7s}.serve-lantern.l3{right:5%;top:27%;animation-delay:1.3s}
.family-table{position:absolute;left:50%;bottom:0;transform:translateX(-50%);width:min(900px,95%);height:46%;background:linear-gradient(#bd704f,#82443f);border-radius:50% 50% 0 0;border-top:12px solid #e5ae6a;box-shadow:0 -20px 40px rgba(25,15,30,.3)}
.table-cloth{position:absolute;left:4%;right:4%;top:17%;height:15%;border-radius:50%;background:#fff0d4;border:4px solid #d7a15b}
.served-cake{position:absolute;left:50%;top:4%;transform:translate(-50%,-50%);font-size:88px;filter:drop-shadow(0 12px 5px rgba(40,20,25,.35));animation:cakePop .8s ease-out}
@keyframes cakePop{from{transform:translate(-50%,10px) scale(.4);opacity:0}to{transform:translate(-50%,-50%) scale(1);opacity:1}}
.family-person{position:absolute;bottom:10%;width:150px;height:230px}.person-a{left:5%}.person-b{left:27%}.person-c{right:27%}.person-d{right:5%}
.pf-head{position:absolute;left:50%;top:0;transform:translateX(-50%);width:72px;height:82px;border-radius:48%;background:#efb38f;z-index:3}.pf-hair{position:absolute;left:50%;top:-8px;transform:translateX(-50%);width:82px;height:65px;border-radius:50% 50% 35% 35%;background:#2a1c2a;z-index:4}.pf-body{position:absolute;left:20px;top:70px;width:110px;height:155px;background:linear-gradient(90deg,#9b304b,#e05f67,#9b304b);clip-path:polygon(25% 0,75% 0,100% 100%,0 100%);z-index:2}.pf-arm{position:absolute;left:92px;top:105px;width:65px;height:22px;background:#efb38f;border-radius:20px;transform:rotate(24deg);z-index:5;transform-origin:left center}
.person-b .pf-body{background:linear-gradient(90deg,#58728a,#9eb4bc,#58728a)}.person-c .pf-body{background:linear-gradient(90deg,#b57a38,#e1a55b,#b57a38)}.person-d .pf-body{background:linear-gradient(90deg,#6f526f,#b887a0,#6f526f)}
.serve-caption{position:absolute;left:50%;top:8%;transform:translateX(-50%);width:min(700px,90%);text-align:center;color:#fff2d1;z-index:10;text-shadow:0 3px 10px #17132a}.serve-caption h2{font:400 clamp(44px,7vw,75px) "Ma Shan Zheng";margin:2px 0}.serve-caption p{font-size:16px;line-height:1.6}.serve-kicker{letter-spacing:3px;font-size:11px;font-weight:900;color:#ffd66f}

/* ============ responsive ============ */
@media(max-width:900px){
  .room{padding-left:3vw;padding-right:3vw}.arcade-panel{order:2}.machine{order:1}
  .family-person{transform:scale(.78);transform-origin:bottom center}.family-person.person-a{left:-1%}.family-person.person-d{right:-1%}

  .topbar{justify-content:flex-start;overflow-x:auto;padding-left:8px}.coin-pill{display:none}
