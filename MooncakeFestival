<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>中秋节 · Mooncake Festival</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=Noto+Sans+SC:wght@400;500;700;900&family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">

<style>
:root{
  --red:#c93635;--darkred:#7d2732;--rose:#df6677;--pink:#ee9aa1;
  --peach:#f2aa8e;--cream:#fff3d8;--paper:#fffaf0;--gold:#e7b446;
  --yellow:#ffd966;--green:#789c61;--purple:#5b4563;--night:#181936;
  --ink:#55323b;--shadow:0 18px 45px rgba(80,32,43,.2);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;font-family:"Quicksand","Noto Sans SC",sans-serif;color:var(--ink);
  background:#f4b39a;overflow-x:hidden;
}
button,input,select{font:inherit}
button{cursor:pointer}
.hidden{display:none!important}

/* ============ floating decoration ============ */
.float{position:fixed;z-index:30;pointer-events:none;animation:float 5s ease-in-out infinite}
.flower{font-size:28px}.f1{left:2%;top:18%}.f2{right:3%;top:31%;animation-delay:1s}
.f3{left:5%;bottom:14%;animation-delay:2s}.f4{right:6%;bottom:18%;animation-delay:.5s}
@keyframes float{50%{transform:translateY(-18px) rotate(8deg)}}

/* ============ navigation ============ */
.topbar{
  position:fixed;top:0;left:0;right:0;z-index:100;height:62px;
  display:flex;align-items:center;justify-content:center;gap:5px;
  background:rgba(255,243,216,.94);backdrop-filter:blur(12px);
  border-bottom:2px solid rgba(125,39,50,.12)
}
.topbar button{
  border:0;background:transparent;color:var(--darkred);padding:9px 14px;border-radius:20px;
  font-weight:800;transition:.2s
}
.topbar button:hover,.topbar button.active{background:var(--red);color:white}
.coin-pill{
  position:absolute;right:18px;background:#ffe796;border:2px solid var(--gold);
  border-radius:20px;padding:7px 12px;font-weight:900
}

/* Every section is a separate "room" */
.room{
  display:none;
  min-height:calc(100vh - 62px);position:relative;overflow:hidden;padding:105px 5vw 65px;
  isolation:isolate;
}
.room.active-room{display:block}.home.active-room{display:grid}\nbody:not(.home-view) footer{display:none}.home-view footer{display:block}
.room-inner{width:min(1120px,100%);margin:auto;position:relative;z-index:3}
/* Each room is an independent screen: only the selected section exists visually. */
.room:not(.active-room){display:none!important}
.room.active-room{min-height:calc(100vh - 62px)}
.home.active-room{min-height:calc(100vh - 62px)}
@media(max-width:760px){
  .topbar{height:auto;min-height:58px;justify-content:flex-start;overflow-x:auto;overflow-y:hidden;padding:7px 88px 7px 8px;white-space:nowrap;scrollbar-width:none}
  .topbar::-webkit-scrollbar{display:none}
  .topbar button{flex:0 0 auto;padding:8px 11px;font-size:12px}
  .coin-pill{right:8px;z-index:2}
  .room.active-room{min-height:calc(100vh - 58px);padding-top:82px}
  .home.active-room{min-height:calc(100vh - 58px)}
}

.title{text-align:center;max-width:800px;margin:0 auto 28px}
.title .kicker{font-size:12px;letter-spacing:3px;text-transform:uppercase;font-weight:900}
.title h2{font:400 clamp(43px,6vw,70px) "Ma Shan Zheng","Noto Sans SC";margin:4px 0}
.title p{line-height:1.7;margin:0}

/* ============ HOME ONLY ============ */
.home{
  background:
    radial-gradient(circle at 20% 25%,#ffe88a 0 2px,transparent 3px),
    radial-gradient(circle at 80% 18%,#ffe88a 0 3px,transparent 4px),
    linear-gradient(180deg,#a73c50,#d55d6a 48%,#efa38c);
  color:#fff5dd;display:grid;place-items:center;text-align:center;
}
.home:after{
  content:"";position:absolute;left:-5%;right:-5%;bottom:-60px;height:220px;
  background:linear-gradient(145deg,transparent 49%,#713447 50% 100%);
  opacity:.45;z-index:1
}
.home-inner{position:relative;z-index:3}
.home-moon{
  width:165px;height:165px;margin:0 auto 22px;border-radius:50%;display:grid;place-items:center;
  background:radial-gradient(circle at 35% 30%,#fff8ce,#ffd96d 65%,#edac3a);
  box-shadow:0 0 80px rgba(255,221,109,.45);font-size:72px;animation:moon 4s ease-in-out infinite
}
@keyframes moon{50%{transform:translateY(-12px)}}
.home h1{font:400 clamp(65px,11vw,125px)/.85 "Ma Shan Zheng";margin:0;text-shadow:5px 7px rgba(93,32,48,.25)}
.home h3{font:400 38px "Ma Shan Zheng";margin:17px 0 7px}
.home p{max-width:680px;margin:0 auto;line-height:1.8;font-size:17px}
.home-actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-top:25px}

/* ============ shared buttons ============ */
.btn{
  border:0;border-radius:999px;padding:12px 20px;font-weight:900;
  box-shadow:0 6px 0 rgba(91,35,45,.18);transition:.18s
}
.btn:hover{transform:translateY(-3px)}
.red{background:var(--red);color:#fff4dc}.gold{background:var(--yellow);color:#683b2e}
.white{background:#fff5e1;color:var(--darkred)}

/* ============ QUOTES ONLY ============ */
.quotes{background:linear-gradient(180deg,#fff0dc,#f4b09b)}
.quote-layout{display:grid;grid-template-columns:290px 1fr;gap:28px;align-items:center}
.quote-info,.tarot-stage{
  background:rgba(255,250,240,.82);border:2px solid #fff;border-radius:28px;
  box-shadow:var(--shadow);padding:24px
}
.quote-info h3{font:400 38px "Ma Shan Zheng";color:var(--red);margin:0}
.quote-info p{line-height:1.7}
.chips{display:flex;flex-wrap:wrap;gap:7px}.chip{
  background:#ffe0da;border:1px solid #efb5ae;padding:7px 10px;border-radius:99px;font-size:12px;font-weight:800
}
.tarot-stage{min-height:570px;display:grid;place-items:center}
.card{
  width:310px;height:470px;perspective:1100px;cursor:pointer
}
.card-inner{width:100%;height:100%;position:relative;transform-style:preserve-3d;transition:.75s}
.card.flipped .card-inner{transform:rotateY(180deg)}
.face{
  position:absolute;inset:0;backface-visibility:hidden;border-radius:25px;border:7px double var(--gold);
  box-shadow:0 20px 45px rgba(81,31,43,.25);padding:22px
}
.front{
  background:
    radial-gradient(circle at 20% 25%,#f7b1ae 0 2px,transparent 3px),
    radial-gradient(circle at 80% 75%,#f7b1ae 0 2px,transparent 3px),
    linear-gradient(145deg,#9e2b3f,#d45162);
  color:#fff1d0;display:grid;place-items:center;text-align:center
}
.front .big{font-size:88px}.front h3{font:400 45px "Ma Shan Zheng";margin:0}
.front small{letter-spacing:2px}
.back{
  transform:rotateY(180deg);background:linear-gradient(145deg,#fff8e2,#ffd9cb);
  display:flex;flex-direction:column;justify-content:center;text-align:center
}
.hanzi{font:400 47px "Ma Shan Zheng","Noto Sans SC";color:var(--red);line-height:1.2}
.pinyin{font-style:italic;color:#93636c;margin:10px 0}
.meaning{font-size:19px;font-weight:900}.explain{font-size:13px;line-height:1.55;margin-top:10px}

/* ============ QUIZ ONLY ============ */
.quiz{background:linear-gradient(180deg,#fff7e4,#ffd8cc)}
.quiz-box{
  width:min(780px,100%);margin:auto;background:#fffaf0;border:3px solid #f0c0ae;
  border-radius:30px;box-shadow:var(--shadow);padding:28px
}
.quiz-top{display:flex;justify-content:space-between;align-items:center;gap:10px}
.quiz-progress{height:10px;background:#efd7ce;border-radius:99px;overflow:hidden;margin:16px 0}
.quiz-progress span{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--red),var(--pink),var(--yellow));transition:.4s}
.q-number{text-align:center;color:#9d6670;font-weight:900}
.q-hanzi{text-align:center;font:400 67px "Ma Shan Zheng";color:var(--red);margin:6px}
.q-pinyin{text-align:center;color:#99636d;font-style:italic}
.question-text{text-align:center;font-weight:900;margin:13px 0}
.options{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.option{
  border:2px solid #eab8aa;background:#fff1df;border-radius:17px;padding:15px;
  color:#643b43;font-weight:800;text-align:left;transition:.15s
}
.option:hover{transform:translateY(-2px);background:#ffe2d6}
.option.correct{background:#dceebc;border-color:#75a259}
.option.wrong{background:#ffd0ce;border-color:#d45c5b}
.option:disabled{cursor:default}
.quiz-message{text-align:center;min-height:30px;font-weight:900;margin:15px 0}
.quiz-bottom{display:flex;justify-content:space-between;align-items:center}

/* ============ KITCHEN ONLY ============ */
.kitchen{
  background:
    linear-gradient(180deg,#efb08c 0 12%,#f8d2b0 12% 15%,#fff0d4 15% 100%);
}
.kitchen-room{
  width:min(1160px,100%);margin:auto;display:grid;grid-template-columns:245px minmax(0,1fr);gap:20px
}
.kitchen-side,.cook-box{
  background:#fffaf0;border:3px solid #e8b9a5;border-radius:28px;box-shadow:var(--shadow)
}
.kitchen-side{padding:18px}
.kitchen-side h3{font:400 33px "Ma Shan Zheng";color:var(--darkred);margin:0 0 10px}
.ingredient{
  display:flex;gap:10px;align-items:center;padding:10px;margin:8px 0;
  border:2px solid #efd0bd;background:#fff5e4;border-radius:14px;cursor:grab;
  user-select:none;transition:.15s
}
.ingredient:hover{transform:translateX(3px);border-color:var(--pink)}
.ingredient.dragging{opacity:.45;transform:scale(.95)}
.ingredient.used{opacity:.3;filter:grayscale(1);cursor:not-allowed}
.ingredient b{font-size:14px}.ingredient small{color:#96646c}
.cook-box{height:650px;position:relative;overflow:hidden;background:#e9a078}
.cook-scene{
  position:absolute;inset:0;
  background:
    linear-gradient(90deg,transparent 47%,rgba(132,70,65,.25) 48% 52%,transparent 53%),
    linear-gradient(180deg,#9ecb8c 0 16%,#eeb283 16% 20%,#fff0d4 20% 100%);
}
.cook-window{
  position:absolute;top:0;left:0;right:0;height:130px;
  background:linear-gradient(#91c67f,#d5df9c);border-bottom:11px solid #bc6c55
}
.cook-window:after{content:"🌿   ☁️   🌿   ☁️   🌿";position:absolute;inset:30px;text-align:center;font-size:30px}
.counter{
  position:absolute;left:7%;right:7%;bottom:9%;height:75px;border-radius:20px;
  background:#d88a67;box-shadow:0 11px #b96557
}
.cook-hint{
  position:absolute;right:16px;top:16px;z-index:20;width:225px;
  background:#fff3ba;border:3px solid #dca64c;border-radius:18px;padding:12px;
  box-shadow:0 9px 20px rgba(90,44,39,.2);font-size:12px
}
.cook-hint strong{color:var(--red);display:block;margin-bottom:3px}
.cook-instruction{
  position:absolute;left:50%;top:155px;transform:translateX(-50%);z-index:15;
  width:55%;text-align:center;background:rgba(255,250,240,.92);padding:11px 15px;border-radius:17px;
  font-weight:900;border:2px solid #efd0b8
}
.cook-counter{
  position:absolute;bottom:22%;left:50%;transform:translateX(-50%);z-index:10;
  font-weight:900;background:#fff4db;border-radius:99px;padding:7px 13px
}
.bowl{
  position:absolute;z-index:5;left:50%;top:51%;transform:translate(-50%,-50%);
  width:290px;height:155px;border-radius:0 0 150px 150px;
  background:linear-gradient(#fff7e9 0 15%,#d43b40 16% 100%);border:7px solid #fff3dd;
  box-shadow:0 18px 25px rgba(77,33,41,.25)
}
.bowl:before{
  content:"";position:absolute;left:17px;right:17px;top:-17px;height:65px;border-radius:50%;
  background:#6d5261;border:7px solid #fff3dd
}
.dough{
  position:absolute;z-index:8;left:50%;top:46%;transform:translate(-50%,-50%);
  width:130px;height:70px;border-radius:50%;background:#f2bd8d;display:grid;place-items:center;
  box-shadow:inset 0 -8px rgba(147,78,56,.15);transition:.3s
}
.dough span{font-size:45px}
.tool{position:absolute;z-index:12;left:50%;top:50%;transform:translate(-50%,-50%);font-size:70px}
.cook-actions{
  position:absolute;z-index:25;left:50%;bottom:14px;transform:translateX(-50%);
  display:flex;gap:8px;flex-wrap:wrap;justify-content:center;width:90%
}
.drop-target{
  position:absolute;z-index:18;left:50%;top:45%;transform:translate(-50%,-50%);
  width:260px;height:145px;border:4px dashed rgba(255,244,214,.9);border-radius:50%;
  display:grid;place-items:center;color:#fff8df;text-shadow:0 2px #7c3d42;font-weight:900;
  background:rgba(124,60,66,.18);transition:.2s
}
.drop-target.over{background:rgba(255,218,115,.35);transform:translate(-50%,-50%) scale(1.05)}
.mixing-bits{position:absolute;z-index:10;inset:0;pointer-events:none}
.bit{position:absolute;font-size:28px;animation:spinbit 1s linear infinite}
@keyframes spinbit{to{transform:rotate(360deg) translateX(20px) rotate(-360deg)}}
.knead-dough{position:absolute;z-index:10;left:50%;top:49%;transform:translate(-50%,-50%);font-size:95px}
.rolling-pin{
  position:absolute;z-index:15;left:50%;top:49%;transform:translate(-50%,-50%);
  font-size:80px;transition:.2s
}
.mold{
  position:absolute;z-index:15;left:50%;top:49%;transform:translate(-50%,-50%);
  font-size:105px
}
.oven{
  position:absolute;z-index:10;left:50%;top:48%;transform:translate(-50%,-50%);
  width:270px;height:190px;border-radius:22px;background:#b7383d;border:8px solid #7d2732;
  box-shadow:inset 0 0 0 8px #e48c70
}
.oven:after{content:"🔥";position:absolute;inset:0;display:grid;place-items:center;font-size:75px}
.oven-light{position:absolute;z-index:14;left:50%;top:50%;transform:translate(-50%,-50%);font-size:60px;opacity:0}
.cook-finish{position:absolute;z-index:30;inset:0;background:rgba(255,245,220,.92);display:grid;place-items:center;text-align:center}
.finish-content{font-size:100px}.finish-content h3{font:400 50px "Ma Shan Zheng";color:var(--red);margin:0}

/* ============ CLAW ONLY ============ */
.claw-room{
  background:linear-gradient(180deg,#db6870,#8e3e57 60%,#4a3150);
  color:#fff2db
}
.arcade{
  width:min(1050px,100%);margin:auto;display:grid;grid-template-columns:1fr 275px;gap:22px
}
.machine{
  background:linear-gradient(90deg,#9e2d3d,#e34d51,#9e2d3d);padding:17px;
  border:9px solid #762737;border-radius:32px;box-shadow:0 25px 55px rgba(38,19,38,.3)
}
.machine-screen{
  height:500px;border-radius:20px;border:7px solid #ffd9bb;overflow:hidden;position:relative;
  background:
    radial-gradient(circle at 15% 22%,#ffe990 0 3px,transparent 4px),
    radial-gradient(circle at 85% 28%,#ffe990 0 3px,transparent 4px),
    linear-gradient(180deg,#4e4263,#76546b)
}
.machine-screen:before{
  content:"";position:absolute;left:0;right:0;bottom:0;height:85px;
  background:linear-gradient(#9d655b,#6b414b)
}
.prize-ball{
  position:absolute;z-index:4;width:62px;height:62px;border-radius:50%;
  display:grid;place-items:center;font-size:29px;
  background:radial-gradient(circle at 30% 25%,#fff2d1,#f0a06e 40%,#bd4650 100%);
  border:4px solid #ffe1b9;box-shadow:0 9px 12px rgba(30,18,36,.3);
  transition:transform .2s
}
.prize-ball.bounce{animation:ballbounce 1.2s ease-in-out infinite}
@keyframes ballbounce{
  0%,100%{transform:translateY(0)}50%{transform:translateY(-17px)}
}
.claw{
  position:absolute;z-index:12;top:0;left:50%;transform:translateX(-50%);
  width:60px;text-align:center;transition:left .12s ease
}
.claw-rope{height:135px;width:5px;background:#f4dbc1;margin:auto}
.claw-hand{font-size:44px;line-height:.5;filter:drop-shadow(0 5px 3px #37243a)}
.claw.grabbing{animation:grab .8s ease}
@keyframes grab{50%{transform:translate(-50%,12px) scale(1.05)}}
.machine-screen{touch-action:none}
.claw-controls{display:flex;justify-content:center;gap:8px;margin-top:14px}
.key{width:47px;height:44px;border:0;border-radius:11px;background:#fff0d8;color:#8c303a;font-weight:900;box-shadow:0 4px #b06057}
.key:active{transform:translateY(3px);box-shadow:none}
.arcade-panel{background:#fff5df;color:var(--ink);border-radius:25px;padding:20px;box-shadow:var(--shadow)}
.arcade-panel h3{font:400 31px "Ma Shan Zheng";color:var(--darkred);margin:0 0 10px}
.prizes{display:grid;gap:8px}.prize-row{display:flex;justify-content:space-between;background:#ffe2d8;border-radius:12px;padding:9px}
.inventory{display:flex;gap:6px;flex-wrap:wrap;font-size:28px}

/* ============ DECOR ONLY ============ */
.decor{background:linear-gradient(180deg,#fff0dc,#f2ae91)}
.decor-layout{display:grid;grid-template-columns:255px 1fr;gap:20px}
.decor-panel,.cake-table{background:#fff9ec;border:3px solid #edc1ac;border-radius:28px;box-shadow:var(--shadow)}
.decor-panel{padding:20px}.decor-panel h3{font:400 33px "Ma Shan Zheng";color:var(--darkred);margin:0}
.decor-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px}
.decor-btn{border:2px solid #e9b8a9;background:#fff0dd;border-radius:13px;padding:12px;font-size:27px}
.cake-table{height:600px;position:relative;overflow:hidden;background:linear-gradient(145deg,#e9a47d,#f3c49c)}
.cake-plate{position:absolute;left:50%;top:62%;transform:translate(-50%,-50%);width:390px;height:105px;background:#fff3d8;border-radius:50%;box-shadow:0 13px #d39a7d}
.cake{position:absolute;left:50%;top:48%;transform:translate(-50%,-50%);width:260px;height:145px;border-radius:50%;
  background:radial-gradient(circle,#7f4c39 0 3px,transparent 4px),linear-gradient(#df9a5a,#b86f3f);
  background-size:28px 24px,auto;border:8px solid #995c3f
}
.cake-word{position:absolute;left:50%;top:47%;transform:translate(-50%,-50%);z-index:5;font:400 34px "Ma Shan Zheng";color:#ffe5a0}
.decor-item{position:absolute;z-index:8;font-size:46px;cursor:grab;user-select:none}
.decor-tip{font-size:12px;line-height:1.5;color:#80505a}

/* ============ GARDEN ONLY ============ */
.garden{
  min-height:100vh;color:#fff2d4;
  background:
    radial-gradient(circle at 15% 25%,#ffd85e 0 2px,transparent 3px),
    radial-gradient(circle at 75% 18%,#ffe993 0 2px,transparent 3px),
    radial-gradient(circle at 38% 47%,#ffd85e 0 3px,transparent 4px),
    radial-gradient(circle at 88% 62%,#ffe993 0 2px,transparent 3px),
    linear-gradient(180deg,#151a3b,#2d234b 55%,#5a3049);
  background-size:170px 150px,210px 170px,180px 160px,230px 190px,auto;
}
.garden:before{
  content:"";position:absolute;inset:auto 0 0;height:38%;
  background:
    radial-gradient(ellipse at 10% 100%,#191a32 0 29%,transparent 30%),
    radial-gradient(ellipse at 55% 100%,#201a36 0 36%,transparent 37%),
    radial-gradient(ellipse at 100% 100%,#17172f 0 30%,transparent 31%);
}
.moon-large{
  position:absolute;right:11%;top:115px;width:125px;height:125px;border-radius:50%;
  background:#ffe89b;box-shadow:0 0 65px rgba(255,219,108,.4);z-index:1
}
.old-house{
  position:absolute;z-index:2;bottom:25%;left:5%;width:190px;height:120px;background:#46253a;
  border:5px solid #8b4b55;border-radius:10px
}
.old-house:before{
  content:"";position:absolute;left:-25px;top:-58px;border-left:120px solid transparent;
  border-right:120px solid transparent;border-bottom:70px solid #7c3442
}
.old-house:after{content:"🏮  🏮";position:absolute;left:35px;top:40px;font-size:30px}
.garden-title{position:relative;z-index:5}
.lantern-cables{position:absolute;top:85px;left:0;right:0;display:flex;justify-content:space-around;z-index:4}
.hanging-lantern{
  width:45px;height:64px;background:#cf3b47;border:3px solid #e5b74e;border-radius:45%;
  box-shadow:0 0 25px rgba(255,205,86,.5);animation:sway 3s ease-in-out infinite
}
.hanging-lantern:after{content:"";position:absolute;width:3px;height:28px;background:#e5b74e;top:61px;left:50%}
@keyframes sway{50%{transform:rotate(5deg) translateY(4px)}}
.flower-bed{position:absolute;z-index:3;bottom:15%;right:7%;font-size:30px;letter-spacing:8px}
.lantern-maker{
  position:relative;z-index:6;width:min(780px,100%);margin:65px auto 0;
  padding:25px;border:2px solid rgba(255,221,154,.45);border-radius:30px;
  background:rgba(255,240,208,.09);backdrop-filter:blur(7px);text-align:center
}
.lantern-preview{
  width:140px;height:180px;margin:0 auto 24px;display:grid;place-items:center;
  border:7px solid #e9bd55;border-radius:47% 47% 40% 40%;
  box-shadow:0 0 45px rgba(255,204,78,.55);font:400 45px "Ma Shan Zheng";color:#ffe7a0;position:relative
}
.lantern-preview:before,.lantern-preview:after{
  content:"";position:absolute;left:50%;transform:translateX(-50%);width:165px;height:7px;background:#e9bd55
}
.lantern-preview:before{top:-13px}.lantern-preview:after{bottom:-13px}
.lantern-form{display:grid;grid-template-columns:1fr 1fr;gap:12px}
