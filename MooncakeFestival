<!-- ==================== HOME: ONLY INTRO ==================== -->
<section class="room home" id="home">
  <div class="home-inner">
    <div class="home-moon">🥮</div>
    <div style="letter-spacing:4px;font-size:12px;font-weight:900">MID-AUTUMN FESTIVAL · 中秋节</div>
    <h1>Mooncake<br>Festival</h1>
    <h3>月圆 · 人团圆</h3>
    <p>
      Sebuah festival interaktif untuk belajar Mandarin, membuat mooncake,
      bermain claw machine, mendekorasi, dan menerbangkan lantern.
    </p>
    <div class="home-actions">
      <button class="btn gold" onclick="go('quotes')">抽一张签 · Draw a Quote</button>
      <button class="btn white" onclick="go('kitchen')">去厨房 · Kitchen</button>
