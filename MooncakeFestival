  .cake-table{height:520px}.cake-plate{width:300px}.cake{width:220px}.decor-grid{gap:6px}.decor-btn{min-height:66px;padding:8px}
  .family-person{transform:scale(.58)}.family-person.person-a{left:-13%}.family-person.person-b{left:13%}.family-person.person-c{right:13%}.family-person.person-d{right:-13%}
  .serve-caption{top:7%}.serve-caption p{font-size:13px}.serve-moon{width:95px;height:95px}

  .room{padding:90px 15px 45px}
