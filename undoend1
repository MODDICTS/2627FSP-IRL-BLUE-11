<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<title>UNDOEND — Pixel Mystery</title>

<style>
* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

html, body {
    margin: 0;
    width: 100%;
    height: 100%;
    background: #08090d;
    color: #fff;
    font-family: "Courier New", monospace;
    overflow: hidden;
}

button {
    font-family: inherit;
    cursor: pointer;
}

#game {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
}

/* =========================================================
   SCREENS
========================================================= */

.screen {
    position: absolute;
    inset: 0;
    display: none;
    justify-content: center;
    align-items: center;
    background:
        radial-gradient(circle at center, #202638 0%, #0c0e16 55%, #050609 100%);
}

.screen.active {
    display: flex;
}

/* =========================================================
   TITLE
========================================================= */

.title-card {
    width: min(900px, 94vw);
    padding: 35px;
    border: 4px solid #d7d9ff;
    background: #10131d;
    box-shadow:
        12px 12px 0 #050609,
        inset 0 0 0 4px #4c526e;
    text-align: center;
}

.logo {
    font-size: clamp(42px, 10vw, 100px);
    letter-spacing: 12px;
    margin: 0;
    color: #f2f1ff;
    text-shadow:
        5px 5px 0 #565b7c,
        9px 9px 0 #171923;
}

.subtitle {
    margin-top: 8px;
    color: #a7aac4;
    letter-spacing: 5px;
}

.story-intro {
    max-width: 700px;
    margin: 30px auto;
    color: #d5d6e2;
    line-height: 1.7;
    font-size: 14px;
}

.pixel-button {
    border: 3px solid #fff;
    background: #252a3d;
    color: white;
    padding: 14px 25px;
    font-weight: bold;
    box-shadow: 5px 5px 0 #000;
    transition: 0.08s;
}

.pixel-button:hover {
    background: #414967;
}

.pixel-button:active {
    transform: translate(4px, 4px);
    box-shadow: 1px 1px 0 #000;
}

/* =========================================================
   CHARACTER SELECT
========================================================= */

.select-box {
    width: min(1100px, 95vw);
    height: min(90vh, 760px);
    overflow-y: auto;
    padding: 25px;
    background: #0d1019;
    border: 4px solid #aaaec7;
    box-shadow: 10px 10px 0 #000;
}

.select-title {
    text-align: center;
    letter-spacing: 5px;
    margin-bottom: 8px;
}

.select-subtitle {
    text-align: center;
    color: #888da9;
    margin-bottom: 25px;
}

.characters {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
}

.character {
    min-height: 310px;
    background: #151a27;
    border: 3px solid #4e546d;
    padding: 14px;
    position: relative;
    transition: 0.1s;
}

.character:hover {
    transform: translateY(-4px);
    border-color: #fff;
}

.character.selected {
    border-color: #fff;
    box-shadow: 0 0 0 3px #757b9c inset;
}

.char-art {
    height: 145px;
    display: flex;
    align-items: center;
    justify-content: center;
    image-rendering: pixelated;
}

.sprite {
    width: 80px;
    height: 105px;
    position: relative;
}

.head {
    width: 44px;
    height: 44px;
    position: absolute;
    left: 18px;
    top: 4px;
    background: #d9a982;
    border: 4px solid #171923;
}

.body {
    width: 52px;
    height: 50px;
    position: absolute;
    left: 14px;
    top: 47px;
    background: #59617f;
    border: 4px solid #171923;
}

.legs {
    width: 45px;
    height: 22px;
    position: absolute;
    left: 17px;
    top: 92px;
    background: #292d3e;
    border: 4px solid #171923;
}

.hair {
    width: 50px;
    height: 21px;
    position: absolute;
    left: 15px;
    top: 1px;
    background: #1a1b25;
    border: 4px solid #171923;
    z-index: 2;
}

.char-name {
    font-size: 20px;
    margin: 5px 0;
}

.char-role {
    color: #9297b2;
    font-size: 12px;
}

.char-description {
    color: #c7c9d6;
    font-size: 12px;
    line-height: 1.5;
    min-height: 54px;
}

.skill {
    color: #f0f0ff;
    font-size: 11px;
    margin-top: 10px;
    border-top: 1px dashed #50556d;
    padding-top: 8px;
}

#startGame {
    display: block;
    margin: 25px auto 5px;
}

/* =========================================================
   GAME SCREEN
========================================================= */

#gameScreen {
    background: #06070a;
}

#gameCanvas {
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    display: block;
}

/* =========================================================
   HUD
========================================================= */

#hud {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 10px;
    pointer-events: none;
}

.hud-top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
}

.hud-box {
    background: rgba(7, 8, 13, 0.9);
    border: 2px solid #777d98;
    padding: 8px 12px;
    font-size: 12px;
    box-shadow: 3px 3px 0 #000;
}

.clue-counter {
    color: #e8e9ff;
}

.relationship {
    margin-top: 7px;
    display: inline-block;
}

.relationship span {
    color: #e3a9d2;
}

/* =========================================================
   MESSAGE BOX
========================================================= */

#message {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    width: min(850px, 92vw);
    background: rgba(9, 10, 16, 0.96);
    border: 3px solid #d9dbee;
    padding: 15px 18px;
    box-shadow: 6px 6px 0 #000;
    display: none;
    z-index: 20;
}

#message.visible {
    display: block;
}

#messageName {
    color: #aaaed0;
    font-weight: bold;
    margin-bottom: 7px;
}

#messageText {
    color: #f0f0f5;
    line-height: 1.55;
    font-size: 14px;
}

.message-hint {
    color: #777c94;
    font-size: 10px;
    margin-top: 8px;
}

/* =========================================================
   CHOICE BOX
========================================================= */

#choices {
    position: absolute;
    left: 50%;
    bottom: 145px;
    transform: translateX(-50%);
    width: min(700px, 90vw);
    display: none;
    gap: 10px;
    flex-direction: column;
    z-index: 25;
}

.choice {
    background: #171b2a;
    color: white;
    border: 2px solid #777c98;
    padding: 12px;
    text-align: left;
}

.choice:hover {
    border-color: white;
    background: #272d43;
}

/* =========================================================
   NEXT AREA
========================================================= */

#nextArea {
    position: absolute;
    right: 20px;
    top: 75px;
    display: none;
    z-index: 30;
}

#nextArea button {
    border: 3px solid white;
    background: #292f47;
    color: white;
    padding: 14px 18px;
    box-shadow: 5px 5px 0 #000;
    font-weight: bold;
}

/* =========================================================
   CONTROLS
========================================================= */

#controls {
    position: absolute;
    left: 20px;
    bottom: 22px;
    width: 190px;
    height: 150px;
    z-index: 30;
}

.dpad {
    position: relative;
    width: 150px;
    height: 150px;
}

.control-button {
    position: absolute;
    width: 52px;
    height: 52px;
    border: 3px solid #d7d9e8;
    background: rgba(26, 29, 43, 0.92);
    color: white;
    font-size: 18px;
    box-shadow: 4px 4px 0 #000;
}

.control-button:active {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 #000;
}

.up {
    left: 49px;
    top: 0;
}

.down {
    left: 49px;
    bottom: 0;
}

.left {
    left: 0;
    top: 49px;
}

.right {
    right: 0;
    top: 49px;
}

.action-buttons {
    position: absolute;
    right: 18px;
    bottom: 35px;
    display: flex;
    gap: 10px;
    z-index: 31;
}

.action {
    width: 62px;
    height: 62px;
    border-radius: 50%;
    border: 3px solid white;
    background: #24293c;
    color: white;
    font-weight: bold;
    box-shadow: 4px 4px 0 #000;
}

/* =========================================================
   CLUE POPUP
========================================================= */

#cluePopup {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(500px, 88vw);
    background: #111522;
    border: 4px solid #e0e2f2;
    padding: 24px;
    box-shadow: 8px 8px 0 #000;
    display: none;
    z-index: 50;
}

#cluePopup.show {
    display: block;
}

.clue-title {
    font-size: 20px;
    margin-bottom: 12px;
}

.clue-text {
    color: #cfd1dc;
    line-height: 1.6;
}

.clue-type {
    margin-top: 15px;
    color: #777d9b;
    font-size: 11px;
}

/* =========================================================
   ENDING
========================================================= */

#endingScreen {
    text-align: center;
    padding: 20px;
}

.ending-card {
    width: min(800px, 92vw);
    background: #10131d;
    border: 4px solid #d7d9ea;
    padding: 35px;
    box-shadow: 10px 10px 0 #000;
}

.ending-title {
    font-size: clamp(28px, 7vw, 55px);
    letter-spacing: 4px;
    margin-bottom: 20px;
}

.ending-text {
    color: #cfd1dc;
    line-height: 1.8;
}

.stats {
    margin: 25px 0;
    color: #a8acc5;
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 750px) {

    .characters {
        grid-template-columns: repeat(2, 1fr);
    }

    .select-box {
        height: 94vh;
        padding: 14px;
    }

    .character {
        min-height: 275px;
    }

    .char-art {
        height: 120px;
    }

    .story-intro {
        font-size: 12px;
    }

    #message {
        bottom: 185px;
    }

    #choices {
        bottom: 190px;
    }

    #nextArea {
        top: 70px;
        right: 10px;
    }

    #nextArea button {
        padding: 10px 12px;
        font-size: 11px;
    }
}

@media (max-width: 430px) {

    .characters {
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .character {
        padding: 9px;
        min-height: 260px;
    }

    .char-description {
        font-size: 10px;
    }

    .skill {
        font-size: 9px;
    }

    .char-name {
        font-size: 16px;
    }

    #controls {
        transform: scale(0.78);
        transform-origin: bottom left;
        left: 5px;
        bottom: 10px;
    }

    .action-buttons {
        transform: scale(0.78);
        transform-origin: bottom right;
        right: 5px;
        bottom: 15px;
    }
}
</style>
</head>

<body>

<div id="game">

<!-- =====================================================
     TITLE SCREEN
===================================================== -->

<section id="titleScreen" class="screen active">

    <div class="title-card">

        <h1 class="logo">UNDOEND</h1>

        <div class="subtitle">
            A PIXEL MYSTERY
        </div>

        <p class="story-intro">
            The world was supposed to end.

            <br><br>

            But someone changed the ending.

            <br><br>

            Four people wake up inside a forgotten research facility
            with fragments of memories, strange drawings, corrupted
            records, and one name appearing everywhere.

            <br><br>

            <strong>LEV.</strong>

            <br><br>

            Find the clues. Discover what happened.
            And decide whether the world deserves its original ending.
        </p>

        <button class="pixel-button" onclick="showCharacterSelect()">
            START INVESTIGATION
        </button>

    </div>

</section>


<!-- =====================================================
     CHARACTER SELECT
===================================================== -->

<section id="characterScreen" class="screen">

    <div class="select-box">

        <h2 class="select-title">
            CHOOSE YOUR INVESTIGATOR
        </h2>

        <div class="select-subtitle">
            Your choice changes dialogue, clues, and relationships.
        </div>

        <div class="characters">

            <!-- YORU -->

            <div class="character" data-char="yoru" onclick="selectCharacter('yoru')">

                <div class="char-art">
                    <div class="sprite">
                        <div class="head"></div>
                        <div class="hair"></div>
                        <div class="body"></div>
                        <div class="legs"></div>
                    </div>
                </div>

                <div class="char-name">YORU</div>
                <div class="char-role">Cashier / Quiet Observer</div>

                <p class="char-description">
                    A calm cashier who remembers small details
                    everyone else ignores.
                </p>

                <div class="skill">
                    SKILL: MEMORY<br>
                    Finds hidden details in ordinary objects.
                </div>

            </div>


            <!-- ZHENYA -->

            <div class="character" data-char="zhenya" onclick="selectCharacter('zhenya')">

                <div class="char-art">
                    <div class="sprite">
                        <div class="head"></div>
                        <div class="hair"></div>
                        <div class="body"></div>
                        <div class="legs"></div>
                    </div>
                </div>

                <div class="char-name">ZHENYA</div>
                <div class="char-role">Art Kid</div>

                <p class="char-description">
                    A strange artist who can recognize patterns
                    hidden inside drawings and symbols.
                </p>

                <div class="skill">
                    SKILL: ART SENSE<br>
                    Reveals visual clues and hidden symbols.
                </div>

            </div>


            <!-- RENÉE -->

            <div class="character" data-char="renee" onclick="selectCharacter('renee')">

                <div class="char-art">
                    <div class="sprite">
                        <div class="head"></div>
                        <div class="hair"></div>
                        <div class="body"></div>
                        <div class="legs"></div>
                    </div>
                </div>

                <div class="char-name">RENÉE</div>
                <div class="char-role">Genius Lil Kid</div>

                <p class="char-description">
                    A tiny genius who understands machines
                    much better than adults do.
                </p>

                <div class="skill">
                    SKILL: LOGIC<br>
                    Solves technological puzzles faster.
                </div>

            </div>


            <!-- ROCCO -->

            <div class="character" data-char="rocco" onclick="selectCharacter('rocco')">

                <div class="char-art">
                    <div class="sprite">
                        <div class="head"></div>
                        <div class="hair"></div>
                        <div class="body"></div>
                        <div class="legs"></div>
                    </div>
                </div>

                <div class="char-name">ROCCO</div>
                <div class="char-role">Gangster</div>

                <p class="char-description">
                    Tough, suspicious, and protective.
                    He knows how dangerous people can be.
                </p>

                <div class="skill">
                    SKILL: INTIMIDATION<br>
                    Gets information from suspicious NPCs.
                </div>

            </div>

        </div>

        <button id="startGame"
                class="pixel-button"
                onclick="startGame()">
            SELECT A CHARACTER
        </button>

    </div>

</section>


<!-- =====================================================
     GAME SCREEN
===================================================== -->

<section id="gameScreen" class="screen">

    <canvas id="gameCanvas"
            width="960"
            height="640">
    </canvas>


    <!-- HUD -->

    <div id="hud">

        <div class="hud-top">

            <div class="hud-box">
                <span id="playerName">PLAYER</span>
                <br>
                <span id="roomName">UNKNOWN</span>
            </div>

            <div class="hud-box clue-counter">
                CLUES:
                <span id="clueCount">0/3</span>
            </div>

        </div>

        <div class="hud-box relationship">
            YORU ♥
            <span id="yoruRelation">0</span>
        </div>

    </div>


    <!-- NEXT AREA -->

    <div id="nextArea">
        <button onclick="nextRoom()">
            NEXT AREA ➜
        </button>
    </div>


    <!-- MESSAGE -->

    <div id="message">

        <div id="messageName">
            SYSTEM
        </div>

        <div id="messageText">
            ...
        </div>

        <div class="message-hint">
            TAP / ENTER / E to continue
        </div>

    </div>


    <!-- CHOICES -->

    <div id="choices"></div>


    <!-- CLUE POPUP -->

    <div id="cluePopup">

        <div class="clue-title"
             id="popupTitle">
            CLUE FOUND
        </div>

        <div class="clue-text"
             id="popupText">
        </div>

        <div class="clue-type"
             id="popupType">
        </div>

        <button class="pixel-button"
                style="margin-top:20px"
                onclick="closeClue()">
            CLOSE
        </button>

    </div>


    <!-- MOBILE D-PAD -->

    <div id="controls">

        <div class="dpad">

            <button class="control-button up"
                    data-key="up">
                ▲
            </button>

            <button class="control-button left"
                    data-key="left">
                ◀
            </button>

            <button class="control-button right"
                    data-key="right">
                ▶
            </button>

            <button class="control-button down"
                    data-key="down">
                ▼
            </button>

        </div>

    </div>


    <div class="action-buttons">

        <button class="action"
                id="lookButton">
            LOOK
        </button>

        <button class="action"
                id="interactButton">
            E
        </button>

    </div>

</section>


<!-- =====================================================
     ENDING
===================================================== -->

<section id="endingScreen" class="screen">

    <div class="ending-card">

        <div class="ending-title"
             id="endingTitle">
            THE END
        </div>

        <div class="ending-text"
             id="endingText">
        </div>

        <div class="stats"
             id="endingStats">
        </div>

        <button class="pixel-button"
                onclick="location.reload()">
            PLAY AGAIN
        </button>

    </div>

</section>

</div>


<script>

/* =========================================================
   GLOBAL STATE
========================================================= */

const canvas = document.getElementById("gameCanvas");
const ctx = canvas.getContext("2d");

ctx.imageSmoothingEnabled = false;

let selectedCharacter = null;

let roomIndex = 0;

let gameRunning = false;

let messageOpen = false;

let cluePopupOpen = false;

let dialogueQueue = [];

let dialogueIndex = 0;

let currentChoiceCallback = null;

let totalCluesFound = 0;

let relationship = {
    yoru: 0
};

let player = {
    x: 480,
    y: 400,
    speed: 3,
    size: 24
};

let keys = {
    up: false,
    down: false,
    left: false,
    right: false
};


/* =========================================================
   CHARACTER DATA
========================================================= */

const characters = {

    yoru: {
        name: "Yoru",
        role: "Cashier",
        color: "#727b9d"
    },

    zhenya: {
        name: "Zhenya",
        role: "Art Kid",
        color: "#9c718e"
    },

    renee: {
        name: "Renée",
        role: "Genius Kid",
        color: "#729c9b"
    },

    rocco: {
        name: "Rocco",
        role: "Gangster",
        color: "#8b735d"
    }

};


/* =========================================================
   ROOM DATA
========================================================= */

const rooms = [

    {

        id: "lab",

        name: "ABANDONED LAB",

        color: "#151c27",

        clues: [

            {
                x: 250,
                y: 220,
                title: "VACCINE RECORD",
                text:
                    "A damaged medical record lists a vaccine trial " +
                    "that was never officially approved. " +
                    "Someone crossed out the name of the final patient.",
                type: "MEDICAL"
            },

            {
                x: 700,
                y: 250,
                title: "CHILD'S DRAWING",
                text:
                    "A child's drawing shows four people standing " +
                    "around a machine. A fifth figure watches from behind.",
                type: "VISUAL"
            },

            {
                x: 480,
                y: 500,
                title: "BURNED TAPE",
                text:
                    "Most of the recording is destroyed. " +
                    "One sentence remains: \"If the clock starts, don't trust him.\"",
                type: "AUDIO"
            }

        ],

        npc: {
            name: "Yoru",
            x: 750,
            y: 500
        }

    },

    {

        id: "bunker",

        name: "UNDERGROUND BUNKER",

        color: "#1a1718",

        clues: [

            {
                x: 180,
                y: 300,
                title: "MISSING PERSON FILE",
                text:
                    "Hundreds of names are listed. " +
                    "Some disappeared years before the apocalypse.",
                type: "RECORD"
            },

            {
                x: 600,
                y: 180,
                title: "STRANGE PHOTOGRAPH",
                text:
                    "The photograph shows the same room you are standing in. " +
                    "But the picture is dated twelve years in the future.",
                type: "PHOTOGRAPH"
            },

            {
                x: 800,
                y: 470,
                title: "LOCKED BOX",
                text:
                    "Inside the box is a broken watch engraved with the initials L.V.",
                type: "OBJECT"
            }

        ],

        npc: {
            name: "Rocco",
            x: 180,
            y: 500
        }

    },

    {

        id: "observatory",

        name: "DEAD OBSERVATORY",

        color: "#131925",

        clues: [

            {
                x: 220,
                y: 180,
                title: "SOLAR SIGNAL",
                text:
                    "A repeating signal is coming from the sun. " +
                    "Its rhythm matches the machine's activation sequence.",
                type: "SIGNAL"
            },

            {
                x: 520,
                y: 300,
                title: "STAR MAP",
                text:
                    "The stars have been rearranged into the shape of a clock.",
                type: "ASTRONOMY"
            },

            {
                x: 760,
                y: 200,
                title: "HIDDEN SYMBOL",
                text:
                    "The symbol is almost identical to the one in Zhenya's drawing.",
                type: "SYMBOL"
            }

        ],

        npc: {
            name: "Renée",
            x: 740,
            y: 500
        }

    },

    {

        id: "core",

        name: "TIME MACHINE CORE",

        color: "#1c1824",

        clues: [

            {
                x: 180,
                y: 200,
                title: "MASTER PLAN",
                text:
                    "The machine was not designed to stop the apocalypse. " +
                    "It was designed to repeat it.",
                type: "MASTER PLAN"
            },

            {
                x: 480,
                y: 150,
                title: "THE ORIGINAL TIMELINE",
                text:
                    "The world ended once. Someone rewound time and erased the evidence.",
                type: "TIMELINE"
            },

            {
                x: 780,
                y: 300,
                title: "LEV'S NOTE",
                text:
                    "Only one line is readable: \"They will never understand why.\"",
                type: "PERSONAL"
            }

        ],

        npc: {
            name: "Lev",
