/* =========================================================
   MOVEMENT
========================================================= */

function updatePlayer() {

    if (!gameRunning) return;

    if (messageOpen || cluePopupOpen) return;

    let dx = 0;

    let dy = 0;

    if (keys.up) dy--;

    if (keys.down) dy++;

    if (keys.left) dx--;

    if (keys.right) dx++;

    if (dx !== 0 && dy !== 0) {

        dx *= 0.707;

        dy *= 0.707;

    }

    player.x += dx * player.speed;

    player.y += dy * player.speed;

    player.x = Math.max(
        50,
        Math.min(910, player.x)
    );

    player.y = Math.max(
        110,
        Math.min(575, player.y)
    );

}


/* =========================================================
   DRAWING
========================================================= */

function drawRoom() {

    const room = rooms[roomIndex];

    ctx.fillStyle = room.color;

    ctx.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    drawFloor();

    drawWalls();

    drawRoomObjects();

    drawClues();

    drawNPC();

    drawPlayer();

}


function drawFloor() {

    ctx.fillStyle = "#222633";

    for (let y = 100; y < 600; y += 32) {

        for (let x = 0; x < 960; x += 32) {

            if (
                ((x / 32) +
                (y / 32)) % 2 === 0
            ) {

                ctx.fillRect(
                    x,
                    y,
                    32,
                    32
                );

            }

        }

    }

}


function drawWalls() {

    ctx.fillStyle = "#090b11";

    ctx.fillRect(
        0,
        0,
        960,
        95
    );

    ctx.fillRect(
        0,
        600,
        960,
        40
    );

    ctx.fillStyle = "#41475c";

    ctx.fillRect(
        0,
        90,
        960,
        6
    );

}


function drawRoomObjects() {

    const room = rooms[roomIndex];

    if (room.id === "lab") {

        drawMachine(
            480,
            250
        );

        drawTable(
            240,
            220
        );

        drawCabinet(
            700,
            230
        );

    }

    if (room.id === "bunker") {

        drawCrates();

        drawComputer(
            600,
            180
        );

        drawTable(
            180,
            300
        );

    }

    if (room.id === "observatory") {

        drawTelescope(
            520,
            300
        );

        drawMachine(
            220,
            180
        );

    }

    if (room.id === "core") {

        drawCoreMachine();

    }

}


function drawTable(x, y) {

    ctx.fillStyle = "#654e42";

    ctx.fillRect(
        x - 45,
        y - 25,
        90,
        50
    );

    ctx.fillStyle = "#2c2020";

    ctx.fillRect(
        x - 45,
        y + 25,
        12,
        45
    );

    ctx.fillRect(
        x + 33,
        y + 25,
        12,
        45
    );

}


function drawCabinet(x, y) {

    ctx.fillStyle = "#373c4d";

    ctx.fillRect(
        x - 35,
        y - 70,
        70,
        140
    );

    ctx.fillStyle = "#11131b";

    for (let i = 0; i < 4; i++) {

        ctx.fillRect(
            x - 25,
            y - 55 + i * 32,
            50,
            20
        );

    }

}


function drawMachine(x, y) {

    ctx.fillStyle = "#4c5368";

    ctx.fillRect(
        x - 60,
        y - 50,
        120,
        100
    );

    ctx.fillStyle = "#141722";

    ctx.fillRect(
        x - 35,
        y - 30,
        70,
        60
    );

    ctx.fillStyle = "#858ba3";

    ctx.fillRect(
        x - 8,
        y - 8,
        16,
        16
    );

}


function drawComputer(x, y) {

    ctx.fillStyle = "#42495d";

    ctx.fillRect(
        x - 45,
        y - 35,
        90,
        65
    );

    ctx.fillStyle = "#10131c";

    ctx.fillRect(
        x - 35,
        y - 25,
        70,
        45
    );

    ctx.fillStyle = "#34394c";

    ctx.fillRect(
        x - 10,
        y + 30,
        20,
        30
    );

}


function drawCrates() {

    for (let i = 0; i < 5; i++) {

        const x =
            70 + (i % 3) * 70;

        const y =
            150 + Math.floor(i / 3) * 70;

        ctx.fillStyle = "#67513e";

        ctx.fillRect(
            x,
            y,
            55,
            55
        );

        ctx.strokeStyle = "#2c211a";

        ctx.lineWidth = 4;

        ctx.strokeRect(
            x,
            y,
            55,
            55
        );

    }

}


function drawTelescope(x, y) {

    ctx.save();

    ctx.translate(x, y);

    ctx.rotate(-0.4);

    ctx.fillStyle = "#656d84";

    ctx.fillRect(
        -65,
        -15,
        120,
        30
    );

    ctx.fillStyle = "#202430";

    ctx.fillRect(
        -70,
        -22,
        18,
        44
    );

    ctx.restore();

    ctx.fillStyle = "#444a5c";

    ctx.fillRect(
        x - 5,
        y + 10,
        10,
        100
    );

}


function drawCoreMachine() {

    const cx = 480;

    const cy = 320;

    ctx.strokeStyle = "#666d88";

    ctx.lineWidth = 8;

    ctx.beginPath();

    ctx.arc(
        cx,
        cy,
        140,
        0,
        Math.PI * 2
    );

    ctx.stroke();

    ctx.strokeStyle = "#3f4559";

    ctx.lineWidth = 4;

    ctx.beginPath();

    ctx.arc(
        cx,
        cy,
        95,
        0,
        Math.PI * 2
    );

    ctx.stroke();

    ctx.fillStyle = "#151824";

    ctx.fillRect(
        cx - 35,
        cy - 35,
        70,
        70
    );

}


function drawClues() {

    const room = rooms[roomIndex];

    room.clues.forEach((clue, index) => {

        const key =
            room.id + "_" + index;

        if (foundClues[key]) {

            return;

        }

        ctx.fillStyle = "#d7d9e8";

        ctx.fillRect(
            clue.x - 8,
            clue.y - 8,
            16,
            16
        );

        ctx.fillStyle = "#656b82";

        ctx.fillRect(
            clue.x - 3,
            clue.y - 3,
            6,
            6
        );

        if (
            Math.abs(player.x - clue.x) < 70 &&
            Math.abs(player.y - clue.y) < 70
        ) {

            ctx.fillStyle = "#fff";

            ctx.font = "12px monospace";

            ctx.fillText(
                "!",
                clue.x + 12,
                clue.y - 12
            );

        }

    });

}


function drawNPC() {

    const room = rooms[roomIndex];

    if (!room.npc) return;

    const npc = room.npc;

    /* Lev gets darker/mysterious appearance */

    if (npc.name === "Lev") {

        ctx.fillStyle = "#090a10";

        ctx.fillRect(
            npc.x - 20,
            npc.y - 45,
            40,
            75
        );

        ctx.fillStyle = "#c3c6db";

        ctx.fillRect(
            npc.x - 12,
            npc.y - 35,
            24,
            25
        );

        ctx.fillStyle = "#08090c";

        ctx.fillRect(
            npc.x - 8,
            npc.y - 30,
            5,
            5
        );

        ctx.fillRect(
            npc.x + 3,
            npc.y - 30,
            5,
            5
        );

        return;

    }

    ctx.fillStyle = "#9a7a67";

    ctx.fillRect(
        npc.x - 14,
        npc.y - 35,
        28,
        28
    );

    ctx.fillStyle = "#4c536d";

    ctx.fillRect(
        npc.x - 20,
        npc.y - 7,
        40,
        50
    );

    ctx.fillStyle = "#222533";

    ctx.fillRect(
        npc.x - 15,
        npc.y + 43,
        12,
        25
    );

    ctx.fillRect(
        npc.x + 3,
        npc.y + 43,
        12,
        25
    );

}


function drawPlayer() {

    const color =
        characters[selectedCharacter].color;

    ctx.fillStyle = "#d9a982";

    ctx.fillRect(
        player.x - 12,
        player.y - 28,
        24,
        24
    );

    ctx.fillStyle = color;

    ctx.fillRect(
        player.x - 15,
        player.y - 4,
        30,
        35
    );

    ctx.fillStyle = "#252837";

    ctx.fillRect(
        player.x - 11,
        player.y + 31,
        9,
        20
    );

    ctx.fillRect(
        player.x + 2,
        player.y + 31,
        9,
        20
    );

}


/* =========================================================
   GAME LOOP
========================================================= */

function gameLoop() {

    if (!gameRunning) return;

    updatePlayer();

    drawRoom();

    requestAnimationFrame(gameLoop);

}


/* =========================================================
   KEYBOARD
========================================================= */

document.addEventListener(
    "keydown",
    e => {

        if (
            e.key === "ArrowUp" ||
            e.key.toLowerCase() === "w"
        ) {

            keys.up = true;

        }

        if (
            e.key === "ArrowDown" ||
            e.key.toLowerCase() === "s"
        ) {

            keys.down = true;

        }

        if (
            e.key === "ArrowLeft" ||
            e.key.toLowerCase() === "a"
        ) {

            keys.left = true;

        }

        if (
            e.key === "ArrowRight" ||
            e.key.toLowerCase() === "d"
        ) {

            keys.right = true;

        }

        if (
            e.key.toLowerCase() === "e" ||
            e.key === "Enter"
        ) {

            interact();

        }

        if (
            e.key.toLowerCase() === "q"
        ) {

            lookAround();

        }

    }
);


document.addEventListener(
    "keyup",
    e => {

        if (
            e.key === "ArrowUp" ||
            e.key.toLowerCase() === "w"
        ) {

            keys.up = false;

        }

        if (
            e.key === "ArrowDown" ||
            e.key.toLowerCase() === "s"
        ) {

            keys.down = false;

        }

        if (
            e.key === "ArrowLeft" ||
            e.key.toLowerCase() === "a"
        ) {

            keys.left = false;

        }

        if (
            e.key === "ArrowRight" ||
            e.key.toLowerCase() === "d"
        ) {

            keys.right = false;

        }

    }
);


/* =========================================================
   MOBILE BUTTONS
========================================================= */

document
    .querySelectorAll(".control-button")
    .forEach(button => {

        const key =
            button.dataset.key;

        button.addEventListener(
            "pointerdown",
            e => {

                e.preventDefault();

                keys[key] = true;

            }
        );

        button.addEventListener(
            "pointerup",
            e => {

                e.preventDefault();

                keys[key] = false;

            }
        );

        button.addEventListener(
            "pointercancel",
            () => {

                keys[key] = false;

            }
        );

        button.addEventListener(
            "pointerleave",
            () => {

                keys[key] = false;

            }
        );

    });


document
    .getElementById("interactButton")
    .addEventListener(
        "pointerdown",
        e => {

            e.preventDefault();

            interact();

        }
    );


document
    .getElementById("lookButton")
    .addEventListener(
        "pointerdown",
        e => {

            e.preventDefault();

            lookAround();

        }
    );


/* =========================================================
   TAP CANVAS
========================================================= */

canvas.addEventListener(
    "pointerdown",
    () => {

        if (messageOpen) {

            advanceDialogue();

        }

        else if (cluePopupOpen) {

            closeClue();

        }

    }
);


/* =========================================================
   PREVENT MOBILE SCROLL
========================================================= */

document.addEventListener(
    "touchmove",
    e => {

        e.preventDefault();

    },
    {
        passive: false
    }
);


/* =========================================================
   INITIAL DRAW
========================================================= */

drawRoom();

</script>

