/* =========================================================
   INIT
========================================================= */

function showCharacterSelect() {

    document
        .getElementById("titleScreen")
        .classList.remove("active");

    document
        .getElementById("characterScreen")
        .classList.add("active");

}


function selectCharacter(id) {

    selectedCharacter = id;

    document
        .querySelectorAll(".character")
        .forEach(card => {
            card.classList.remove("selected");
        });

    document
        .querySelector(`[data-char="${id}"]`)
        .classList.add("selected");

    document.getElementById("startGame").textContent =
        "PLAY AS " + characters[id].name.toUpperCase();

}


function startGame() {

    if (!selectedCharacter) {

        alert("Choose a character first.");

        return;

    }

    document
        .getElementById("characterScreen")
        .classList.remove("active");

    document
        .getElementById("gameScreen")
        .classList.add("active");

    gameRunning = true;

    roomIndex = 0;

    totalCluesFound = 0;

    relationship.yoru = 0;

    player.x = 480;

    player.y = 400;

    updateHUD();

    openingDialogue();

