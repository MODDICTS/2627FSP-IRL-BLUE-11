/* =========================================================
   DIALOGUE SYSTEM
========================================================= */

function showDialogue(lines) {

    dialogueQueue = lines;

    dialogueIndex = 0;

    messageOpen = true;

    renderDialogue();

}


function renderDialogue() {

    if (dialogueIndex >= dialogueQueue.length) {

        closeDialogue();

        return;

    }

    const line = dialogueQueue[dialogueIndex];

    document.getElementById("messageName").textContent =
        line.name;

    document.getElementById("messageText").textContent =
        line.text;

    document.getElementById("message")
        .classList.add("visible");

}


function advanceDialogue() {

    if (!messageOpen) return;

    dialogueIndex++;

    if (dialogueIndex >= dialogueQueue.length) {

        closeDialogue();

    } else {

        renderDialogue();

    }

}


function closeDialogue() {

    messageOpen = false;

    document.getElementById("message")
        .classList.remove("visible");

}


/* =========================================================
   CHOICES
========================================================= */

function showChoices(options, callback) {

    const box = document.getElementById("choices");

    box.innerHTML = "";

    box.style.display = "flex";

    options.forEach(option => {

        const button = document.createElement("button");

        button.className = "choice";

        button.textContent = option.text;

        button.onclick = () => {

            box.style.display = "none";

            callback(option.id);

        };

        box.appendChild(button);

    });

}


/* =========================================================
   CLUE SYSTEM
========================================================= */

let foundClues = {};

function getRoomKey() {

    return rooms[roomIndex].id;

}


function investigateClue(clueIndex) {

    const room = rooms[roomIndex];

    const key =
        room.id + "_" + clueIndex;

    if (foundClues[key]) {

        showDialogue([

            {
                name: "SYSTEM",
                text:
                    "You've already examined this."
            }

        ]);

        return;

    }

    foundClues[key] = true;

    totalCluesFound++;

    showClue(
        room.clues[clueIndex]
    );

    updateHUD();

    if (roomComplete()) {

        setTimeout(() => {

            showDialogue([

                {
                    name: "SYSTEM",
                    text:
                        "ALL CLUES FOUND."
                },

                {
                    name: "SYSTEM",
                    text:
                        "The path forward is open."
                }

            ]);

            document
                .getElementById("nextArea")
                .style.display = "block";

        }, 400);

    }

}


function showClue(clue) {

    cluePopupOpen = true;

    document
        .getElementById("popupTitle")
        .textContent =
        "CLUE FOUND: " + clue.title;

    document
        .getElementById("popupText")
        .textContent =
        clue.text;

    document
        .getElementById("popupType")
        .textContent =
        "CATEGORY: " + clue.type;

    document
        .getElementById("cluePopup")
        .classList.add("show");

}


function closeClue() {

    cluePopupOpen = false;

    document
        .getElementById("cluePopup")
        .classList.remove("show");

}


function roomComplete() {

    const room = rooms[roomIndex];

    return room.clues.every(
        (_, i) =>
            foundClues[room.id + "_" + i]
    );

}


function getRoomClueCount() {

    const room = rooms[roomIndex];

    return room.clues.filter(
        (_, i) =>
            foundClues[room.id + "_" + i]
    ).length;

}


/* =========================================================
   NEXT ROOM
========================================================= */

function nextRoom() {

    if (!roomComplete()) return;

    document
        .getElementById("nextArea")
        .style.display = "none";

    roomIndex++;

    player.x = 480;

    player.y = 500;

    if (roomIndex >= rooms.length) {

