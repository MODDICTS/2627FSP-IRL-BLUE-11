/* =========================================================
   NPC INTERACTION
========================================================= */

function interact() {

    if (messageOpen) {

        advanceDialogue();

        return;

    }

    if (cluePopupOpen) {

        closeClue();

        return;

    }

    const room = rooms[roomIndex];

    /* check clues */

    for (let i = 0; i < room.clues.length; i++) {

        const clue = room.clues[i];

        if (
            Math.abs(player.x - clue.x) < 50 &&
            Math.abs(player.y - clue.y) < 50
        ) {

            investigateClue(i);

            return;

        }

    }

    /* check NPC */

    if (room.npc) {

        if (
            Math.abs(player.x - room.npc.x) < 80 &&
            Math.abs(player.y - room.npc.y) < 80
        ) {

            talkToNPC(room.npc.name);

            return;

        }

    }

    showDialogue([

        {
            name: "SYSTEM",
            text:
                "Nothing useful here."
        }

    ]);

}


