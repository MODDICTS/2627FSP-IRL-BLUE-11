/* =========================================================
   LOOK SYSTEM
========================================================= */

function lookAround() {

    const room = rooms[roomIndex];

    let closest = null;

    let distance = Infinity;

    room.clues.forEach((clue, index) => {

        const dx = player.x - clue.x;

        const dy = player.y - clue.y;

        const d = Math.sqrt(dx * dx + dy * dy);

        if (d < distance) {

            distance = d;

            closest = {
                clue,
                index
            };

        }

    });

    if (closest && distance < 160) {

        showDialogue([

            {
                name: "SYSTEM",
                text:
                    "Something catches your attention..."
            },

            {
                name: characters[selectedCharacter].name,
                text:
                    getCharacterInvestigation(
                        closest.clue
                    )
            }

        ]);

        return;

    }

    showDialogue([

        {
            name: "SYSTEM",
            text:
                "The room is silent."
        },

        {
            name: "SYSTEM",
            text:
                "But you feel like you're being watched."

        }

    ]);

}


function getCharacterInvestigation(clue) {

    if (selectedCharacter === "zhenya") {

        if (
            clue.type === "VISUAL" ||
            clue.type === "SYMBOL"
        ) {

            return "The shapes repeat. This isn't decoration. It's a message.";

        }

        return "There are deliberate marks here. Someone wanted this found.";

    }

    if (selectedCharacter === "renee") {

        if (
            clue.type === "MACHINE" ||
            clue.type === "SIGNAL" ||
            clue.type === "TIMELINE"
        ) {

            return "The numbers don't make sense... unless time itself is part of the equation.";

        }

        return "Someone organized this information very carefully.";

    }

    if (selectedCharacter === "rocco") {

        return "Someone staged this scene. Nobody leaves evidence this clean by accident.";

    }

    return "I should remember this.";

}


